<aside class="w-full md:w-72 bg-secondary text-light flex flex-col flex-shrink-0
              md:sticky md:top-0 md:h-screen
              overflow-hidden
              max-h-[40vh] md:max-h-none
              border-b md:border-b-0 md:border-r border-sidebar-border">

  <!-- Brand -->
  <div class="flex items-center gap-3 px-6 py-5 border-b border-sidebar-border">
    <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary">
      <svg
        class="h-5 w-5 text-light"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="1.8"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M12 3l8.5 4.75v8.5L12 21l-8.5-4.75v-8.5L12 3z"
        />
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M3.5 7.75L12 12.5l8.5-4.75M12 12.5V21"
        />
      </svg>
    </div>

    <div>
      <h1 class="text-xl font-semibold text-light tracking-tight">
        TAMAM
      </h1>

      <p class="text-xs text-text-muted">
        Mobile Admin
      </p>
    </div>
  </div>

  <!-- Navigation -->
  <nav class="flex-1 px-4 py-6 space-y-1 overflow-y-auto">
    <% admin_sidebar_menu.each do |item| %>
      <% next unless admin_sidebar_item_visible?(item) %>

      <% if item[:children].present? %>
        <div class="pt-3 first:pt-0">
          <div class="px-3 pb-2 text-xs font-semibold uppercase tracking-wider text-text-muted">
            <%= item[:label] %>
          </div>

          <div class="space-y-1">
            <% item[:children].each do |child| %>
              <% next unless admin_sidebar_item_visible?(child) %>

              <% active = admin_sidebar_item_active?(child) %>

              <%= link_to child[:path],
                    class: "flex items-center gap-3 px-3 py-2.5 rounded-xl transition-colors #{active ? 'bg-primary text-light shadow-sm' : 'text-light hover:bg-primary'}" do %>

                <span class="text-sm font-medium">
                  <%= child[:label] %>
                </span>

              <% end %>
            <% end %>
          </div>
        </div>
      <% else %>
        <% active = admin_sidebar_item_active?(item) %>

        <%= link_to item[:path],
              class: "flex items-center gap-3 px-3 py-2.5 rounded-xl transition-colors #{active ? 'bg-primary text-light shadow-sm' : 'text-light hover:bg-primary'}" do %>

          <span class="text-sm font-medium">
            <%= item[:label] %>
          </span>

        <% end %>
      <% end %>
    <% end %>
  </nav>

  <!-- Footer -->
  <!-- ==================== USER AREA (FOOTER) ==================== -->
  <div class="mt-auto border-t border-sidebar-border bg-secondary/40">

  <!-- Profile chip -->
  <div class="px-4 pt-4 pb-3">
    <div class="flex items-center gap-3 rounded-xl bg-primary/20 px-3 py-2.5 ring-1 ring-inset ring-white/5">

      <!-- Avatar -->
      <div class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full bg-primary text-sm font-semibold text-light">
        <%= current_admin&.name&.first&.upcase || "A" %>
      </div>

      <!-- Name + role -->
      <div class="min-w-0 flex-1">
        <p class="truncate text-sm font-medium text-light">
          <%= current_admin&.name || "Admin" %>
        </p>
        <p class="truncate text-xs text-text-muted">
          <%= current_admin&.email || "admin@tamam.app" %>
        </p>
      </div>

      <!-- Status dot -->
      <span class="flex h-2 w-2 flex-shrink-0 rounded-full bg-emerald-400 shadow-[0_0_6px_#34d399]" title="Online"></span>
    </div>
  </div>

  <!-- Actions row -->
  <div class="flex items-center justify-between gap-2 px-4 pb-4">

    <!-- Language switcher -->
    <%= link_to "#",
          title: I18n.locale.to_s == "ar" ? "Switch to English" : "التبديل إلى العربية",
          aria: { label: I18n.locale.to_s == "ar" ? "Switch to English" : "التبديل إلى العربية" },
          class: "group flex items-center gap-2 rounded-lg border border-sidebar-border px-2.5 py-1.5 text-xs text-text-muted transition-colors hover:border-primary hover:bg-primary hover:text-light" do %>

      <span class="text-base leading-none">
        <%= I18n.locale.to_s == "ar" ? "🇺🇸" : "🇸🇦" %>
      </span>

      <span class="font-medium">
        <%= I18n.locale.to_s == "ar" ? "EN" : "AR" %>
      </span>
    <% end %>

    <!-- Logout -->
    <%= button_to admin_logout_path,
          method: :delete,
          title: "Logout",
          aria: { label: "Logout" },
          class: "group flex items-center gap-2 rounded-lg border border-sidebar-border px-2.5 py-1.5 text-xs text-text-muted transition-colors hover:border-red-500/60 hover:bg-red-500/10 hover:text-red-300" do %>

      <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10 17l5-5-5-5M15 12H3" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 19V5a2 2 0 00-2-2h-6" />
      </svg>

      <span class="font-medium">Logout</span>
    <% end %>
  </div>
  </div>

</aside>
