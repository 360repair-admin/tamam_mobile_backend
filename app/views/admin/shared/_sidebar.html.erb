<aside class="w-full md:w-72 bg-secondary text-light flex flex-col flex-shrink-0 overflow-y-auto sidebar-scroll
               max-h-[40vh] md:max-h-none border-b md:border-b-0 md:border-r border-sidebar-border">

  <!-- Brand -->
  <div class="flex items-center gap-3 px-6 py-5 border-b border-sidebar-border">
    <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary">
      <svg
        class="h-5 w-5 text-light"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="1.8"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M12 3l8.5 4.75v8.5L12 21l-8.5-4.75v-8.5L12 3z"
        />
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M3.5 7.75L12 12.5l8.5-4.75M12 12.5V21"
        />
      </svg>
    </div>

    <div>
      <h1 class="text-xl font-semibold text-light tracking-tight">
        TAMAM
      </h1>

      <p class="text-xs text-text-muted">
        Mobile Admin
      </p>
    </div>
  </div>

  <!-- Navigation -->
  <nav class="flex-1 px-4 py-6 space-y-6 overflow-y-auto">

    <!-- Main -->
    <div>
      <p class="px-3 text-[0.65rem] font-semibold uppercase tracking-wider text-text-muted mb-2">
        Main
      </p>

      <div class="space-y-1">

        <!-- Dashboard -->
        <%= link_to admin_dashboard_path,
              class: "flex items-center gap-3 px-3 py-2.5 rounded-xl transition-colors #{request.path == admin_dashboard_path ? 'bg-primary text-light shadow-sm' : 'text-text-muted hover:bg-primary hover:text-light'}" do %>

          <svg
            class="h-5 w-5 flex-shrink-0"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3 13h8V3H3v10zm10 8h8V3h-8v18zM3 21h8v-6H3v6z"
            />
          </svg>

          <span class="text-sm font-medium">
            Dashboard
          </span>
        <% end %>

        <!-- Customers -->
        <%= link_to admin_customers_path,
              class: "flex items-center gap-3 px-3 py-2.5 rounded-xl transition-colors #{request.path.start_with?('/admin/customers') ? 'bg-primary text-light shadow-sm' : 'text-text-muted hover:bg-primary hover:text-light'}" do %>

          <svg
            class="h-5 w-5 flex-shrink-0"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2"
            />
            <circle cx="9" cy="7" r="4" />
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M22 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"
            />
          </svg>

          <span class="text-sm font-medium">
            Customers
          </span>

          <span class="ml-auto text-xs bg-tertiary text-primary px-2 py-0.5 rounded-full font-medium">
            <%= Customer.count %>
          </span>
        <% end %>

      </div>
    </div>

    <!-- Configuration -->
    <div>
      <p class="px-3 text-[0.65rem] font-semibold uppercase tracking-wider text-text-muted mb-2">
        Configuration
      </p>

      <div class="space-y-1">

        <!-- Configurations -->
        <%= link_to "#",
              class: "flex items-center gap-3 px-3 py-2.5 rounded-xl text-text-muted hover:bg-primary hover:text-light transition-colors" do %>

          <svg
            class="h-5 w-5 flex-shrink-0"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <circle cx="12" cy="12" r="3.5" />
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M19.4 15a1.7 1.7 0 00.34 1.88l.06.06-1.8 1.8-.06-.06a1.7 1.7 0 00-1.88-.34 1.7 1.7 0 00-1.03 1.56V20h-2.55v-.1a1.7 1.7 0 00-1.03-1.56 1.7 1.7 0 00-1.88.34l-.06.06-1.8-1.8.06-.06A1.7 1.7 0 008.1 15a1.7 1.7 0 00-1.56-1.03H6.5v-2.55h.04A1.7 1.7 0 008.1 10.4a1.7 1.7 0 00-.34-1.88L7.7 8.46l1.8-1.8.06.06a1.7 1.7 0 001.88.34A1.7 1.7 0 0012.47 5.5v-.04h2.55v.04a1.7 1.7 0 001.03 1.56 1.7 1.7 0 001.88-.34l.06-.06 1.8 1.8-.06.06a1.7 1.7 0 00-.34 1.88A1.7 1.7 0 0020.95 11h.05v2.55h-.05A1.7 1.7 0 0019.4 15z"
            />
          </svg>

          <span class="text-sm font-medium">
            Configurations
          </span>
        <% end %>

        <!-- Vehicle Resources -->
        <%= link_to "#",
              class: "flex items-center gap-3 px-3 py-2.5 rounded-xl text-text-muted hover:bg-primary hover:text-light transition-colors" do %>

          <svg
            class="h-5 w-5 flex-shrink-0"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M5 17h14l-1-7H6l-1 7z"
            />
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M7 10l2-4h6l2 4"
            />
            <circle cx="8" cy="18" r="1.5" />
            <circle cx="16" cy="18" r="1.5" />
          </svg>

          <span class="text-sm font-medium">
            Vehicle Resources
          </span>
        <% end %>

        <!-- Service Categories -->
        <%= link_to "#",
              class: "flex items-center gap-3 px-3 py-2.5 rounded-xl text-text-muted hover:bg-primary hover:text-light transition-colors" do %>

          <svg
            class="h-5 w-5 flex-shrink-0"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M4 6h16M4 12h16M4 18h16"
            />
          </svg>

          <span class="text-sm font-medium">
            Service Categories
          </span>
        <% end %>

      </div>
    </div>

    <!-- System -->
    <div>
      <p class="px-3 text-[0.65rem] font-semibold uppercase tracking-wider text-text-muted mb-2">
        System
      </p>

      <div class="space-y-1">

        <!-- Infrastructure -->
        <%= link_to "#",
              class: "flex items-center gap-3 px-3 py-2.5 rounded-xl text-text-muted hover:bg-primary hover:text-light transition-colors" do %>

          <svg
            class="h-5 w-5 flex-shrink-0"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <rect x="4" y="4" width="16" height="16" rx="2" />
            <path
              stroke-linecap="round"
              d="M8 8h8M8 12h8M8 16h5"
            />
          </svg>

          <span class="text-sm font-medium">
            Infrastructure
          </span>
        <% end %>

        <!-- Security -->
        <%= link_to "#",
              class: "flex items-center gap-3 px-3 py-2.5 rounded-xl text-text-muted hover:bg-primary hover:text-light transition-colors" do %>

          <svg
            class="h-5 w-5 flex-shrink-0"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 3l7 3v5c0 4.5-3 7.5-7 10-4-2.5-7-5.5-7-10V6l7-3z"
            />
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 12l2 2 4-4"
            />
          </svg>

          <span class="text-sm font-medium">
            Security
          </span>
        <% end %>

        <!-- Integrations -->
        <%= link_to "#",
              class: "flex items-center gap-3 px-3 py-2.5 rounded-xl text-text-muted hover:bg-primary hover:text-light transition-colors" do %>

          <svg
            class="h-5 w-5 flex-shrink-0"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M13 2L3 14h7l-1 8 10-12h-7l1-8z"
            />
          </svg>

          <span class="text-sm font-medium">
            Integrations
          </span>
        <% end %>

      </div>
    </div>

    <!-- Support -->
    <div>
      <p class="px-3 text-[0.65rem] font-semibold uppercase tracking-wider text-text-muted mb-2">
        Support
      </p>

      <div class="space-y-1">

        <!-- Help Center -->
        <%= link_to "#",
              class: "flex items-center gap-3 px-3 py-2.5 rounded-xl text-text-muted hover:bg-primary hover:text-light transition-colors" do %>

          <svg
            class="h-5 w-5 flex-shrink-0"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <circle cx="12" cy="12" r="9" />
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9.5 9a2.5 2.5 0 115 0c0 1.7-2.5 2-2.5 3.5"
            />
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 16h.01"
            />
          </svg>

          <span class="text-sm font-medium">
            Help Center
          </span>
        <% end %>

        <!-- Settings -->
        <%= link_to "#",
              class: "flex items-center gap-3 px-3 py-2.5 rounded-xl text-text-muted hover:bg-primary hover:text-light transition-colors" do %>

          <svg
            class="h-5 w-5 flex-shrink-0"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <circle cx="12" cy="12" r="3.5" />
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M19.4 15a1.7 1.7 0 00.34 1.88l.06.06-1.8 1.8-.06-.06a1.7 1.7 0 00-1.88-.34 1.7 1.7 0 00-1.03 1.56V20h-2.55v-.1a1.7 1.7 0 00-1.03-1.56 1.7 1.7 0 00-1.88.34l-.06.06-1.8-1.8.06-.06A1.7 1.7 0 008.1 15a1.7 1.7 0 00-1.56-1.03H6.5v-2.55h.04A1.7 1.7 0 008.1 10.4a1.7 1.7 0 00-.34-1.88L7.7 8.46l1.8-1.8.06.06a1.7 1.7 0 001.88.34A1.7 1.7 0 0012.47 5.5v-.04h2.55v.04a1.7 1.7 0 001.03 1.56 1.7 1.7 0 001.88-.34l.06-.06 1.8 1.8-.06.06a1.7 1.7 0 00-.34 1.88A1.7 1.7 0 0020.95 11h.05v2.55h-.05A1.7 1.7 0 0019.4 15z"
            />
          </svg>

          <span class="text-sm font-medium">
            Settings
          </span>
        <% end %>

      </div>
    </div>

  </nav>

  <!-- Footer -->
  <div class="px-6 py-5 border-t border-sidebar-border mt-auto">

    <div class="flex items-center gap-2 text-xs text-text-muted">
      <span class="w-2 h-2 rounded-full bg-success"></span>
      <span>All systems operational</span>
    </div>

    <div class="flex gap-4 mt-3 text-[0.7rem] text-text-muted">

      <span class="flex items-center gap-1">
        <svg
          class="h-3.5 w-3.5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.8"
        >
          <circle cx="12" cy="12" r="9" />
          <path
            stroke-linecap="round"
            d="M12 7v5l3 2"
          />
        </svg>

        v1.0.0
      </span>

      <span class="flex items-center gap-1">
        <svg
          class="h-3.5 w-3.5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.8"
        >
          <rect x="5" y="10" width="14" height="10" rx="2" />
          <path
            stroke-linecap="round"
            d="M8 10V7a4 4 0 018 0v3"
          />
        </svg>

        secure
      </span>

    </div>
  </div>

</aside>
