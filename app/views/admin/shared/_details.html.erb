<div class="overflow-hidden rounded-xl border border-border bg-surface shadow-sm">
  <% if title.present? %>
    <div class="border-b border-border bg-primary px-6 py-4">
      <h3 class="text-sm font-semibold uppercase tracking-wider text-light">
        <%= title %>
      </h3>
    </div>
  <% end %>

  <div class="overflow-x-auto">
    <table class="min-w-full">
      <tbody class="divide-y divide-border-light">
        <% fields.each do |field| %>
          <% next if field[:condition].present? && !field[:condition].call(record) %>

          <% value =
            if field[:render].present?
              field[:render].call(record)
            else
              record.public_send(field[:attribute])
            end
          %>

          <tr class="hover:bg-tertiary/50">
            <th
              scope="row"
              class="w-1/3 whitespace-nowrap bg-page px-6 py-4 text-left text-sm font-medium text-primary"
            >
              <%= field[:label] %>
            </th>

            <td
              class="px-6 py-4 text-sm text-text <%= field[:value_class] %>"
            >
              <% if value.present? %>
                <%= value %>
              <% else %>
                <span class="text-text-muted">
                  <%= field.fetch(:fallback, "Empty") %>
                </span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
